# Copy to .env (docker compose reads it on its own).

# The domain for the registry and search site, with DNS pointing at this server.
# Caddy gets a certificate for it from Let's Encrypt on first start.
CHUNGUS_DOMAIN=chungus.example.com

# The image for the node and registry. Default: the latest build of main.
#CHUNGUS_IMAGE=ghcr.io/buwunny/chungus:0.1.0
