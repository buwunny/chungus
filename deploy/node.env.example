# Copy to node.env and fill in. Read by docker-compose.yml. Each variable is a flag of
# `chungus node` (CHUNGUS_MAX_UPLOAD is --max-upload, and so on); lists are
# comma-separated. Leave a variable commented out rather than empty: an empty value is
# an error, not "unset".

# Where peers can reach this server: its public IP, on TCP and QUIC (UDP) port 4001.
# Open both in the provider's firewall.
CHUNGUS_EXTERNAL=/ip4/203.0.113.7/tcp/4001,/ip4/203.0.113.7/udp/4001/quic-v1

# Upload cap in MB/s across all peers. Keep it below your plan's fair-use limit:
# 20 MB/s sustained is about 52 TB a month.
CHUNGUS_MAX_UPLOAD=20
CHUNGUS_MAX_CONNECTIONS=400

# Relay for peers behind NAT. It only carries chungus connections between two peers
# that both asked for it, and these caps bound it further. Set CHUNGUS_RELAY_SERVER=false
# for a plain bootstrap node.
CHUNGUS_RELAY_SERVER=true
CHUNGUS_RELAY_MAX_CIRCUITS=32
CHUNGUS_RELAY_CIRCUIT_MB=1024
CHUNGUS_RELAY_CIRCUIT_SECS=600

# Prometheus metrics at http://<addr>/metrics. Inside the container, listen on 0.0.0.0
# and publish the port to the host's loopback only, e.g. "127.0.0.1:9101:9101" under
# ports in docker-compose.yml.
#CHUNGUS_METRICS=0.0.0.0:9101

# Follow a registry's blocklist: refuse to hold or serve blocked models and chunks.
# Pin the operator's key so a hijacked registry can't swap it.
#CHUNGUS_BLOCKLIST=https://chungus.example.com
#CHUNGUS_OPERATOR=chungus1...
# Keep the registry's signed anchor nodes in the routing table (needs CHUNGUS_OPERATOR).
#CHUNGUS_ANCHORS_FROM=https://chungus.example.com

# Other nodes to join through, multiaddrs ending in /p2p/<peer id>. By default a node
# joins through the project's public node; set CHUNGUS_NO_DEFAULT_BOOTSTRAP=true to start
# a separate swarm instead.
#CHUNGUS_BOOTSTRAP=/ip4/198.51.100.2/tcp/4001/p2p/12D3KooW...
#CHUNGUS_NO_DEFAULT_BOOTSTRAP=true

# List this node on the registry's leaderboard under a display name. Registers with
# CHUNGUS_REGISTRY, or else the CHUNGUS_BLOCKLIST registry, which also receives the
# receipts downloaders hand this node.
#CHUNGUS_LEADERBOARD=bunny burrow
#CHUNGUS_REGISTRY=https://chungus.example.com
# Anchor nodes only: probe the listed nodes for uptime and models held.
#CHUNGUS_PROBE=true
